# Copy this file to .env and fill in your real values.
# .env is already in .gitignore -- never commit it.

OLLAMA_MODEL=llama3.1:8b

IMAP_HOST=imap.gmail.com
IMAP_USER=support@yourcompany.com
IMAP_PASS=your-16-character-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@yourcompany.com
SMTP_PASS=your-16-character-app-password

CHROMA_DIR=./chroma_db
LOG_PATH=./logs/audit.jsonl

# How often the poller checks the inbox when running unattended (--mode poll)
POLL_INTERVAL_SECONDS=60

# Keep this true until you have tested end-to-end. When true, the sender
# only prints what it WOULD send -- no real email goes out.
DRY_RUN=true

# --- Review page authentication (required before exposing it publicly) ---
REVIEW_USERNAME=admin
# Leave this blank to have the app auto-generate a random admin password
# on first run, printed ONCE to `docker compose logs review` -- log in
# with it and change it under "My Account". Only set this yourself (via
# python deploy/hash_password.py) if you want to choose the first-run
# password instead of letting the app generate one.
REVIEW_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Set to false ONLY when testing locally over plain http. Keep true for
# anything reachable from the internet.
COOKIE_SECURE=true

# How much detail shows up in `docker compose logs`. DEBUG for
# troubleshooting, INFO for normal operation.
LOG_LEVEL=INFO
