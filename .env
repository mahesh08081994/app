SMTP_PASS=bvszgqtnodbipgwn

CHROMA_DIR=./chroma_db
LOG_PATH=./logs/audit.jsonl

# How often the poller checks the inbox when running unattended (--mode poll)
POLL_INTERVAL_SECONDS=60

# SAFETY DEFAULT -- keep true until you've verified this fresh deployment
# end-to-end (login works, a test email drafts/escalates correctly, and a
# real send succeeds) before flipping to false.
DRY_RUN=true

# --- Review page authentication ---
REVIEW_USERNAME=admin
# Left blank on purpose: the app will auto-generate a random admin
# password on first run and print it ONCE to `docker compose logs review`.
# Log in with that, then change it under "My Account". Do not fill this
# in unless you specifically want to set the first-run password yourself
# (see deploy/hash_password.py if you do).
REVIEW_PASSWORD_HASH=
FLASK_SECRET_KEY=210b7c85c4b6ff379d6d728bd34252512c121206dafab5dadd795843767d1717
# Keep true for anything reachable from the internet.
COOKIE_SECURE=true

# How much detail shows up in `docker compose logs`. DEBUG for
# troubleshooting, INFO for normal operation.
LOG_LEVEL=INFO
